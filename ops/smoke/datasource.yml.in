apiVersion: 1

deleteDatasources:
  - name: Coop smoke Prometheus
    orgId: 1

datasources:
  - name: Coop smoke Prometheus
    uid: coop-prometheus
    type: prometheus
    access: proxy
    url: http://127.0.0.1:@PROMETHEUS_PORT@
    isDefault: true
    editable: false
    jsonData:
      httpMethod: POST
