        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(perch_worker_transport_queue_wait_seconds_bucket{deployment=~\"$deployment\",outcome=\"acquired\"}[$__rate_interval])))", "legendFormat": "worker handoff wait p95", "range": true, "refId": "B" },
