      "targets": [{ "editorMode": "code", "expr": "sum(rate(perch_requests_total{deployment=~\"$deployment\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(perch_requests_total{deployment=~\"$deployment\"}[$__rate_interval])), 0.001)", "legendFormat": "5xx ratio", "range": true, "refId": "A" }],
      "title": "HTTP 5xx ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
