# Perry patch — ungate plugin codegen from needs_ui
#
# Discovered while building Perch v0 Phase A.
#
# Bug: Plugin runtime FFI declarations (perry_plugin_register_*,
# perry_plugin_set_metadata, etc.) live inside `if self.needs_ui {` in
# crates/perry-codegen/src/runtime_decls.rs (gate opens at line 9480, closes
# at line 11634). This means a TS file that imports `perry/plugin` without
# also importing `perry/ui` fails to compile with:
#     Error compiling module 'X.ts': In function 'activate':
#     perry_plugin_register_tool not declared
#
# Perry's own crates/perry/test-files/test_plugin.ts reproduces this. It is
# load-bearing for Perch because every Perch deployment is a Perry plugin
# but never imports perry/ui.
#
# `ctx.needs_plugins` already exists in compile.rs (set when "perry/plugin"
# is imported, see compile.rs:2191), but it was never plumbed into the
# codegen Compiler struct. This patch:
#   1. Adds `needs_plugins` field + setter to perry-codegen Compiler
#   2. Plumbs it from compile.rs at the codegen creation site
#   3. Relaxes the gate at runtime_decls.rs:9480 to accept either flag
#
# Verified working: Phase A.2 (Rust host dlopens Perry plugin and invokes
# a registered tool) passes end-to-end with this patch in place.
#
# Apply with: cd ~/projects/perry/perry && git apply <this-file>

diff --git a/crates/perry-codegen/src/codegen.rs b/crates/perry-codegen/src/codegen.rs
--- a/crates/perry-codegen/src/codegen.rs
+++ b/crates/perry-codegen/src/codegen.rs
@@ -69,6 +69,9 @@
     /// Whether perry/ui is needed (controls UI/system/plugin function declarations)
     pub(crate) needs_ui: bool,
+    /// Whether perry/plugin is needed (controls plugin FFI function declarations
+    /// independently of UI — required for non-UI plugin builds like Perch deployments).
+    pub(crate) needs_plugins: bool,
     /// Whether dotenv/config was imported (needs auto-init call)
     pub(crate) needs_dotenv_init: bool,
@@ -279,6 +282,7 @@
             needs_js_runtime: false,
             needs_stdlib: true,  // Default to true for backwards compatibility
             needs_ui: false,
+            needs_plugins: false,
             needs_dotenv_init: false,
             is_entry_module: true,  // Default to true for single-module compilation
@@ -322,6 +326,13 @@
     pub fn set_needs_ui(&mut self, needs: bool) {
         self.needs_ui = needs;
     }
+
+    /// Set whether perry/plugin is needed (controls plugin FFI function declarations
+    /// independently of UI — required for non-UI plugin builds like Perch deployments).
+    pub fn set_needs_plugins(&mut self, needs: bool) {
+        self.needs_plugins = needs;
+    }
+
     /// Set whether this is the entry module (generates main function)

diff --git a/crates/perry-codegen/src/runtime_decls.rs b/crates/perry-codegen/src/runtime_decls.rs
--- a/crates/perry-codegen/src/runtime_decls.rs
+++ b/crates/perry-codegen/src/runtime_decls.rs
@@ -9477,7 +9477,15 @@
             self.extern_funcs.insert(Cow::Borrowed("js_fastify_ctx_redirect"), func_id);
         }

-        if self.needs_ui {
+        // The UI/system/plugin sections share one big gate. Plugin FFI must be
+        // declared whenever a TS file imports `perry/plugin`, even when there
+        // is no UI in the source — Perch deployments are a key example: they
+        // are Perry plugins but never touch perry/ui. Extending the gate to
+        // include `needs_plugins` declares a few extra UI extern symbols when
+        // a plugin-only build runs, but Cranelift only emits references to
+        // symbols the user actually calls, so the unused declarations are
+        // free at link time.
+        if self.needs_ui || self.needs_plugins {
         // ============================================
         // Perry UI FFI functions
         // ============================================
@@ -11631,7 +11639,7 @@
             let func_id = self.module.declare_function("perry_plugin_list_tools", Linkage::Import, &sig)?;
             self.extern_funcs.insert(Cow::Borrowed("perry_plugin_list_tools"), func_id);
         }
-        } // end if self.needs_ui (UI/system/audio/plugin sections)
+        } // end if self.needs_ui || self.needs_plugins (UI/system/audio/plugin sections)

diff --git a/crates/perry/src/commands/compile.rs b/crates/perry/src/commands/compile.rs
--- a/crates/perry/src/commands/compile.rs
+++ b/crates/perry/src/commands/compile.rs
@@ -4408,6 +4408,7 @@

             compiler.set_needs_stdlib(ctx.needs_stdlib);
             compiler.set_needs_ui(ctx.needs_ui);
+            compiler.set_needs_plugins(ctx.needs_plugins);
             compiler.set_needs_geisterhand(ctx.needs_geisterhand);
             compiler.set_geisterhand_port(ctx.geisterhand_port);
